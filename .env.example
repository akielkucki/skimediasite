# ─────────────────────────────────────────────────────────────────────────────
# Environment variables
#
# Copy to `.env.local` and fill in what you need:
#     cp .env.example .env.local
#
# EVERY variable here is optional. With none of them set, the site runs from
# the local seed content in src/data/, all forms validate and report honestly
# that no provider is connected, and nothing crashes. Add them as you connect
# real services.
# ─────────────────────────────────────────────────────────────────────────────


# ── Site ─────────────────────────────────────────────────────────────────────
# Canonical origin, no trailing slash. Used for canonical URLs, Open Graph
# images, the sitemap, RSS and share links.
# Default when unset: http://localhost:3000
# REQUIRED for a production build — the build fails without it.
NEXT_PUBLIC_SITE_URL=https://example.com

# Explicit demo switch. A production build refuses to serve the fictional
# seed content (articles, sponsors, newsroom) unless this is set to "true".
# Development always has seed content and does not need this.
NEXT_PUBLIC_ENABLE_DEMO_CONTENT=

# Set to "preview" or "staging" on non-production deployments to force
# noindex (Vercel preview deployments are detected automatically).
NEXT_PUBLIC_DEPLOY_ENV=


# ── CMS: Sanity ──────────────────────────────────────────────────────────────
# Without these the site serves the seed content in src/data/. With them, the
# content layer reads from Sanity and falls back to the seed data on error.
# Find the project id at https://sanity.io/manage — see docs/CMS.md.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Read token with "Viewer" permissions. ONLY needed for draft/preview mode —
# published content is read without it. Server-side only; never NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=

# Shared secret for the (not yet built) draft-mode route. See docs/CMS.md.
SANITY_PREVIEW_SECRET=


# ── Forms ────────────────────────────────────────────────────────────────────
# No email provider is connected out of the box. Until CONTACT_FORM_ENDPOINT is
# set, the contact and sponsorship forms validate the submission, log it
# server-side, and tell the user plainly that it was NOT delivered.
#
# Point this at any endpoint that accepts a JSON POST — a Resend/SendGrid
# wrapper, a Formspree URL, a Zapier hook, or your own route handler.
# See docs/INTEGRATIONS.md.
CONTACT_FORM_ENDPOINT=
CONTACT_FORM_API_KEY=
